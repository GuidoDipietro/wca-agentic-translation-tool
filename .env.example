# Weblate token: read only by the server. Do not share it.
WEBLATE_TOKEN=
# Optional address of a LibreTranslate server for the Argos provider. Leave it empty to use the libretranslate command installed on this machine.
LIBRETRANSLATE_URL=
# API key for that LibreTranslate server. Leave it empty unless the server requires one.
LIBRETRANSLATE_API_KEY=
